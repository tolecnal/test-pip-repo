{
  "include": [
    "harness",
    "pkg/src",
    "pkg/tests"
  ],
  "exclude": [
    "**/__pycache__",
    ".venvs",
    "dist",
    "build"
  ],
  "extraPaths": [
    "pkg/src"
  ],
  "venvPath": ".venvs",
  "venv": "lint",
  "pythonVersion": "3.11",
  "typeCheckingMode": "standard",
  "reportMissingTypeStubs": false,
  "reportMissingModuleSource": "error"
}
